rules_version = '2';

// Who may read/write what. Everything not allowed here is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid} and everything under it (transactions, accounts, cards, goals)
    // can only be touched by the signed-in user whose id is {uid},
    // and only after they confirmed their e-mail (opened the link we sent).
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid
                         && request.auth.token.email_verified == true;
    }
  }
}
